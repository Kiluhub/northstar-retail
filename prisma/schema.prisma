generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryEventType {
  STOCK_RECEIVED
  STOCK_PICKED
  STOCK_SHIPPED
  STOCK_RESERVED
  STOCK_RELEASED
  STOCK_ADJUSTED
  STOCK_DAMAGED
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
}

enum SyncMode {
  POLLING
  WEBHOOK
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory       Inventory[]
  inventoryEvents InventoryEvent[]

  @@map("warehouses")
}

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  barcode   String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory       Inventory[]
  inventoryEvents InventoryEvent[]
  inventoryCaches InventoryCache[]

  @@map("products")
}

model Inventory {
  id               String   @id @default(cuid())
  warehouseId      String
  productId        String
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory")
}

model InventoryEvent {
  id            String             @id @default(cuid())
  eventId       String             @unique
  type          InventoryEventType
  warehouseId   String
  productId     String
  quantityDelta Int
  reference     String?
  reason        String?
  source        String
  occurredAt    DateTime
  createdAt     DateTime           @default(now())
  syncStatus    SyncStatus         @default(PENDING)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([productId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([syncStatus])
  @@map("inventory_events")
}

model SyncRun {
  id           String     @id @default(cuid())
  mode         SyncMode
  startedAt    DateTime
  completedAt  DateTime?
  itemsFetched Int        @default(0)
  itemsChanged Int        @default(0)
  status       SyncStatus
  error        String?
  createdAt    DateTime   @default(now())

  @@index([mode, startedAt])
  @@map("sync_runs")
}

model ProcessedEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_events")
}

model InventoryCache {
  id                String   @id @default(cuid())
  productId         String
  warehouseId       String
  physicalQuantity  Int
  reservedQuantity  Int
  availableQuantity Int
  lastEventId       String?
  lastUpdatedAt     DateTime
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory_cache")
}
